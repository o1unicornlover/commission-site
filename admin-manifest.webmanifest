{
  "id": "./admin.html",
  "name": "Commission Studio Admin",
  "short_name": "Studio Admin",
  "description": "Private commission management dashboard for commissions, progress, payments, chat, gallery, pricing, and site settings.",
  "start_url": "./admin.html",
  "scope": "./admin.html",
  "display": "standalone",
  "background_color": "#fffdfc",
  "theme_color": "#ff4da8",
  "prefer_related_applications": false,
  "shortcuts": [
    {
      "name": "Inbox",
      "short_name": "Inbox",
      "description": "Open client messages",
      "url": "./admin.html#inbox",
      "icons": [{ "src": "./admin-icon-192.svg", "sizes": "192x192", "type": "image/svg+xml" }]
    },
    {
      "name": "Commissions",
      "short_name": "Commissions",
      "description": "Open commission management",
      "url": "./admin.html#commissions",
      "icons": [{ "src": "./admin-icon-192.svg", "sizes": "192x192", "type": "image/svg+xml" }]
    }
  ],
  "icons": [
    {
      "src": "./admin-icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./admin-icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ]
}
